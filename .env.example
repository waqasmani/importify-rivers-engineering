# REA Importify configuration for deploy/docker-compose.yml.
# Create deploy/.env from this file with generated secrets:   deploy/scripts/init-env.sh
# Never commit deploy/.env. Every variable is optional unless marked REQUIRED.

# ---- Address ----
# How the web server listens (see deploy/proxy/Caddyfile):
#   rea.example.com (automatic HTTPS) | https://localhost | http://localhost | :80 (behind another proxy)
REA_SITE_ADDRESS=http://localhost
# The URL people and the browser extension use to reach REA. Must match REA_SITE_ADDRESS.
REA_PUBLIC_URL=http://localhost
# Published ports and bind address of the web server.
REA_HTTP_PORT=80
REA_HTTPS_PORT=443
REA_BIND_ADDRESS=0.0.0.0
# E-mail for Let's Encrypt registration (public domains only).
REA_ACME_EMAIL=

# ---- Secrets (REQUIRED; generated by init-env.sh) ----
# PostgreSQL password (hex, URL-safe).
POSTGRES_PASSWORD=
# 32 random bytes, base64. Encrypts stored AI provider keys. Keep it with your backups; without it
# stored API keys cannot be decrypted.
REA_SECRET_KEY=
# One-time token required by the first-run setup page. Unused after setup.
REA_SETUP_TOKEN=

# ---- Features ----
# embedded: the API process runs background jobs. off: run the separate worker
# (docker compose --profile worker up -d).
REA_WORKER_MODE=embedded
REA_WORKER_CONCURRENCY=2
# Allow the server to fetch public URLs for website analysis (robots.txt respected, private
# networks blocked unless REA_FETCH_ALLOW_PRIVATE_NETWORKS=true). Off by default.
REA_SERVER_FETCH_ENABLED=false
REA_FETCH_ALLOW_PRIVATE_NETWORKS=false
# Comma-separated directories (inside the API container) that may be analyzed as repository paths.
# Mount them read-only in docker-compose.yml first. Empty disables repository-path sources.
REA_REPO_ROOTS=

# ---- Limits ----
REA_MAX_UPLOAD_MB=25
REA_MAX_ARCHIVE_UNCOMPRESSED_MB=300
REA_MAX_ARCHIVE_FILES=20000
REA_PROXY_MAX_BODY=600MB

# ---- Sessions ----
REA_SESSION_TTL=168h
REA_SESSION_IDLE=24h

# ---- Browser extension ----
# Extra allowed origins, comma-separated. Add chrome-extension://<id> only when you build the
# extension with your own key (the default ID olceibeplclcegianhjffambadoakkno is always allowed).
REA_ALLOWED_ORIGINS=

# ---- Operations ----
REA_LOG_LEVEL=info
REA_VERSION=1.0.0
# Docker network for the stack. The API trusts X-Forwarded-For only from this subnet.
REA_DOCKER_SUBNET=172.29.10.0/24
# Proxies in front of Caddy whose X-Forwarded-For may be trusted (Caddy syntax).
REA_UPSTREAM_TRUSTED_PROXIES=private_ranges
# Backups kept by deploy/scripts/backup.sh (older ones are deleted).
REA_BACKUP_KEEP=14
