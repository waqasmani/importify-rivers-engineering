{
  "name": "@rea/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REA Importify browser extension for Chrome (Manifest V3)",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@rea/api-types": "workspace:*",
    "lucide-vue-next": "1.0.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
