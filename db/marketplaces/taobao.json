{
  "key": "taobao",
  "name": "Taobao",
  "region": "china",
  "description": "Taobao item pages: title, images, shop, properties and SKUs from the embedded __ICE_APP_CONTEXT__ loader data; SKU property paths are joined to option names and prices are looked up in sku2info. Prices are in CNY.",
  "domains": ["taobao.com", "*.taobao.com"],
  "priority": 60,
  "version": 1,
  "verification": {
    "status": "synthetic_fixture",
    "fixture": "testdata/fixtures/marketplaces/taobao.html",
    "fixture_url": "https://item.taobao.com/item.htm?id=712345678901",
    "note": "Assumes window.__ICE_APP_CONTEXT__ = { loaderData: { home: { data: { res: { item, seller, skuBase.props/skus (propPath 'pid:vid;pid:vid'), skuCore.sku2info keyed by skuId with '0' as the default offer, props } } } } }. Not yet checked against saved real pages."
  },
  "rules": {
    "schema": 1,
    "currency": "CNY",
    "product_signal": { "any": [{ "source": "ice", "path": "loaderData.home.data.res.item.title" }] },
    "sources": { "ice": { "kind": "script_marker", "marker": "window.__ICE_APP_CONTEXT__" } },
    "fields": {
      "title": [
        { "source": "ice", "path": "loaderData.home.data.res.item.title", "transforms": ["trim"] },
        { "css": "h1.mainTitle" }
      ],
      "sku": [{ "source": "ice", "path": "loaderData.home.data.res.item.itemId" }],
      "brand": [{ "source": "ice", "path": "loaderData.home.data.res.props[?name=品牌].value" }],
      "price": [{ "source": "ice", "path": "loaderData.home.data.res.skuCore.sku2info.0.price.priceText" }],
      "availability": [{ "source": "ice", "path": "loaderData.home.data.res.skuCore.sku2info.0.quantity", "transforms": ["stock"] }],
      "images": [{ "source": "ice", "path": "loaderData.home.data.res.item.images", "transforms": ["protocol_fix", "image_original"] }],
      "specifications": [{ "source": "ice", "path": "loaderData.home.data.res.props", "entry": { "name": "name", "value": "value" } }],
      "supplier_name": [{ "source": "ice", "path": "loaderData.home.data.res.seller.shopName" }],
      "supplier_url": [{ "source": "ice", "path": "loaderData.home.data.res.seller.shopUrl" }],
      "shipping": [{ "source": "ice", "path": "loaderData.home.data.res.delivery.postage" }]
    },
    "variants": {
      "mode": "property_join",
      "properties": {
        "source": "ice",
        "path": "loaderData.home.data.res.skuBase.props",
        "id": "pid",
        "name": "name",
        "values": "values",
        "value_id": "vid",
        "value_name": "name",
        "value_image": { "path": "image", "transforms": ["protocol_fix"] }
      },
      "skus": { "source": "ice", "path": "loaderData.home.data.res.skuBase.skus", "ids": "propPath", "separator": ";", "sku": "skuId" },
      "offers": { "source": "ice", "path": "loaderData.home.data.res.skuCore.sku2info", "key": "skuId", "price": "price.priceText", "stock": "quantity" }
    }
  }
}
