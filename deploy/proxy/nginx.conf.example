# Example: an existing nginx terminates TLS and forwards to the REA web container.
# In deploy/.env set:
#   REA_SITE_ADDRESS=:80
#   REA_BIND_ADDRESS=127.0.0.1
#   REA_HTTP_PORT=8081
#   REA_PUBLIC_URL=https://rea.example.com
# then `docker compose -f deploy/docker-compose.yml up -d` and reload nginx.
server {
    listen 443 ssl;
    http2 on;
    server_name rea.example.com;

    ssl_certificate     /etc/letsencrypt/live/rea.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rea.example.com/privkey.pem;

    # Uploads (repository archives, documents) go through this proxy.
    client_max_body_size 600m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }
}

server {
    listen 80;
    server_name rea.example.com;
    return 301 https://$host$request_uri;
}
