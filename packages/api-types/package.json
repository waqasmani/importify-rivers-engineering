{
  "name": "@rea/api-types",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript types generated from the REA OpenAPI document",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
